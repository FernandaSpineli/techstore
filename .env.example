# Copy to .env and adjust. Never commit .env.

APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=15s

APP_BASE_URL=http://localhost:8080

# Signs access tokens (HS256). At least 32 characters; generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=30m

# How long stock stays reserved for an order awaiting payment.
ORDER_RESERVATION_TTL=30m

# Redis-backed protections and cache.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300
CATALOG_CACHE_TTL=60s

# Stripe (test mode). Leave both empty to run without payments.
#   STRIPE_SECRET_KEY:     Dashboard > Developers > API keys (sk_test_...)
#   STRIPE_WEBHOOK_SECRET: printed by the Stripe CLI, see README "Payments"
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Outgoing email. docker compose runs Mailpit on these ports (UI on :8025).
SMTP_ADDR=localhost:1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=TechStore <no-reply@techstore.local>

# Matches the local-only credentials in docker-compose.yml.
DATABASE_URL=postgres://techstore:techstore@localhost:5432/techstore?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Host ports used by docker compose (change if they are already taken).
HTTP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_UI_PORT=8025
