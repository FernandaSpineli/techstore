# Copy to .env and adjust. Never commit .env.

APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=15s

# Matches the local-only credentials in docker-compose.yml.
DATABASE_URL=postgres://techstore:techstore@localhost:5432/techstore?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Host ports used by docker compose (change if they are already taken).
HTTP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
